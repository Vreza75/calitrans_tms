# Copy this file to .streamlit/secrets.toml and fill in real values.
# Do not commit .streamlit/secrets.toml — it is gitignored.
#
# For Supabase, use Project Settings > Database > Connection string,
# in the SQLAlchemy form beginning with postgresql+psycopg2://

DATABASE_URL = "postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME"

OPENAI_API_KEY = "sk-your-openai-api-key"
OPENAI_RESPONSE_MODEL = "gpt-4o-mini"

# Yahoo mailbox credentials (per-mailbox app passwords, not account passwords)
DISPATCH_YAHOO_EMAIL = "dispatch@example.com"
DISPATCH_YAHOO_APP_PASSWORD = "your-app-password"
MARGIE_YAHOO_EMAIL = "margie@example.com"
MARGIE_YAHOO_APP_PASSWORD = "your-app-password"
ACCOUNTING_YAHOO_EMAIL = "accounting@example.com"
ACCOUNTING_YAHOO_APP_PASSWORD = "your-app-password"

IMAP_SERVER = "imap.mail.yahoo.com"
IMAP_PORT = 993

SMTP_HOST = "smtp.mail.yahoo.com"
SMTP_PORT = 465
SMTP_USER = "dispatch@example.com"
SMTP_PASSWORD = "your-app-password"
DISPATCH_EMAIL = "dispatch@example.com"

DOCUMENT_STORAGE_DIR = "storage/load_documents"

PORT_HOUSTON_CLIENT_ID = "your-port-houston-client-id"
PORT_HOUSTON_CLIENT_SECRET = "your-port-houston-client-secret"
PORT_HOUSTON_OPERATOR = "your-operator-code"

TWILIO_ACCOUNT_SID = "ACyour-twilio-account-sid"
TWILIO_AUTH_TOKEN = "your-twilio-auth-token"
TWILIO_FROM_NUMBER = "+15555550100"

OPERATIONS_SHOW_AI_DEBUG = "false"
