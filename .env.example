# CaliTrans TMS — example environment configuration.
# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL / Supabase connection string
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME

# OpenAI (AI parsing / drafting)
OPENAI_API_KEY=sk-your-key-here
OPENAI_RESPONSE_MODEL=gpt-4o-mini

# Operations mailbox (Yahoo IMAP/SMTP)
YAHOO_EMAIL=operations@example.com
YAHOO_APP_PASSWORD=your-app-password
IMAP_SERVER=imap.mail.yahoo.com
SMTP_HOST=smtp.mail.yahoo.com

# Local document storage directory
DOCUMENT_STORAGE_DIR=storage

# Twilio (driver dispatch SMS)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+15551234567

# Debug toggles
OPERATIONS_SHOW_AI_DEBUG=0
