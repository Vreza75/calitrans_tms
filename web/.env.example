# Copy to .env.local for local development. Every value here is
# browser-safe (NEXT_PUBLIC_*) - see docs/architecture/WEB_CLIENT.md's
# "Security" section for what must NEVER go in this file (service-role
# keys, DB credentials, SESSION_SECRET_KEY - those are backend-only,
# read from the repo root's own .env, never from web/).

# FastAPI base URL (api/main.py). Local dev default matches
# `uvicorn api.main:app --reload` on its default port.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Supabase project used for Realtime Broadcast (realtime/publisher.py's
# server side, this client's browser side). Publishable/anon key only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
